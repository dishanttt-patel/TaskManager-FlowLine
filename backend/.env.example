# Copy this file to .env and fill in real values before running the server.

# MongoDB connection string. For local dev: mongodb://localhost:27017/taskmanager
# For MongoDB Atlas (cloud, free tier): get this from your Atlas dashboard.
MONGO_URI=mongodb://localhost:27017/taskmanager

# Secret used to sign JWT tokens. Use a long random string in production.
JWT_SECRET=replace_this_with_a_long_random_secret

# How long a login session stays valid.
JWT_EXPIRES_IN=7d

# Port the API server listens on.
PORT=5000

# Comma-separated list of origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173
